# Telegram bot configuration
TELEGRAM_BOT_TOKEN=
# Comma-separated list of Telegram user IDs with admin access
BOT_ADMIN_IDS=

# Send a message to all known private chats on each bot startup (1=on, 0=off)
BOT_STARTUP_BROADCAST_ENABLED=0
# Plain text, up to 4096 characters; double quotes support \n for line breaks
BOT_STARTUP_BROADCAST_TEXT="Бот запущен и готов к работе!"

# Paths configuration
BOT_DB_PATH=./vsco_links.db
# Leave empty to use the default system temp path (e.g., /tmp/vsco-bot/work)
BOT_WORKDIR=./work
# Leave empty to store logs inside the bot working directory
BOT_LOGDIR=./logs

# Message sending behavior (seconds)
BOT_SEND_TIMEOUT=600

# VSCO media scanning configuration
BOT_MEDIA_SCAN_MAX_WIDTH=2048
BOT_PROFILE_SCAN_WORKERS=2
BOT_META_FETCH_WORKERS=2
BOT_PROFILE_NORMALIZE_CONCURRENCY=4
# Enable Playwright inline fallbacks in the bot (1/0)
BOT_INLINE_PLAYWRIGHT=0
# Playwright Firefox: 1=headless, 0=visible window (requires a graphical desktop)
BOT_BROWSER_HEADLESS=1
# 1=keep browser after success/error until manually closed; requires HEADLESS=0
# Debug mode: the task (and download queue) waits for the window to close
BOT_BROWSER_KEEP_OPEN=0

# Required access configuration for users
# Channel/group ID or @username; empty ID disables the corresponding membership check
BOT_REQUIRED_CHANNEL_ID=
BOT_REQUIRED_CHANNEL_LABEL=
BOT_REQUIRED_CHANNEL_LINK=
BOT_REQUIRED_GROUP_ID=
BOT_REQUIRED_GROUP_LABEL=
BOT_REQUIRED_GROUP_LINK=
# New unique VSCO profile links required for bot access; 0 disables this requirement
BOT_REQUIRED_UNIQUE_LINKS=10
# Membership check cache lifetime in seconds
BOT_REQUIRED_ACCESS_CACHE_TTL=30

# Download/export access: minimum new profiles added over the last 24 hours
# 0 disables this requirement; BOT_ADMIN_IDS users bypass access restrictions
BOT_DAILY_PROFILE_LIMIT=20

# Archive channels configuration
BOT_ARCHIVE_CHANNEL_ID=
BOT_ARCHIVE_ADMIN_CHANNEL_ID=
BOT_ARCHIVE_SUMMARY_CHANNEL_ID=

# Link notifications
BOT_LINKS_NOTIFY_CHAT_ID=
BOT_LINKS_NOTIFY_AT=
BOT_LINKS_NOTIFY_LIMIT=20

# Logging configuration
LOG_LEVEL=INFO

# VSCO export settings (bytes, default 45 MB)
VSCO_EXPORT_ZIP_THRESHOLD=47185920

# Local export server authentication (optional)
VSCO_HOST_USERNAME=
VSCO_HOST_PASSWORD=
