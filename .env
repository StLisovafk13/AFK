# Telegram bot configuration
TELEGRAM_BOT_TOKEN=
# Comma-separated list of Telegram user IDs with admin access
BOT_ADMIN_IDS=

# Paths configuration
BOT_DB_PATH=vsco_links.db
# Leave empty to use the default system temp path (e.g., /tmp/vsco-bot/work)
BOT_WORKDIR=
# Leave empty to store logs inside the bot working directory
BOT_LOGDIR=./logs

# Message sending behavior (seconds)
BOT_SEND_TIMEOUT=600

# VSCO media scanning configuration
BOT_MEDIA_SCAN_MAX_WIDTH=2048

# Required access configuration for users
BOT_REQUIRED_CHANNEL_ID=
BOT_REQUIRED_CHANNEL_LABEL=
BOT_REQUIRED_CHANNEL_LINK=
BOT_REQUIRED_GROUP_ID=
BOT_REQUIRED_GROUP_LABEL=
BOT_REQUIRED_GROUP_LINK=
BOT_REQUIRED_ACCESS_CACHE_TTL=30

# Archive channels configuration
BOT_ARCHIVE_CHANNEL_ID=
BOT_ARCHIVE_ADMIN_CHANNEL_ID=
BOT_ARCHIVE_SUMMARY_CHANNEL_ID=

# Logging configuration
LOG_LEVEL=INFO

# VSCO export settings (bytes, default 45 MB)
VSCO_EXPORT_ZIP_THRESHOLD=47185920
