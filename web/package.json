{
  "name": "afk-vsco-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build:client && node scripts/wrangler.mjs dev --local --ip 127.0.0.1 --port 8787",
    "build:client": "vite build",
    "build": "npm run build:client && node scripts/wrangler.mjs deploy --dry-run --outdir dist/worker",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "^0.5.10",
    "@types/leaflet": "^1.9.20",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
